{
  "name": "fliprag",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive dev",
    "dev:web": "pnpm --filter @fliprag/web dev",
    "dev:server": "pnpm --filter @fliprag/server dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm --recursive test",
    "clean": "pnpm --recursive exec rm -rf dist node_modules && rm -rf node_modules",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/biome check --staged --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "simple-git-hooks": "^2.14.0",
    "typescript": "catalog:"
  }
}
