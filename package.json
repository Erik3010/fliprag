{
  "name": "fliprag",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive dev",
    "dev:web": "pnpm --filter @fliprag/web dev",
    "dev:server": "pnpm --filter @fliprag/server dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm --recursive test",
    "clean": "pnpm --recursive exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "catalog:"
  }
}
